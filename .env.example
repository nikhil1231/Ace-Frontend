# The app calls its backend at /api on its own origin (nginx proxies it in production,
# src/setupProxy.js under `npm start`). Override only to call a backend elsewhere.
# REACT_APP_API_BASE_URL=/api

# `npm start` only: the backend /api is proxied to (run it with ACCESS_DEV_EMAIL set).
# ACE_DEV_BACKEND=http://localhost:8000

# Google Maps JavaScript API key used by the map page.
REACT_APP_GOOGLE_MAPS_API=your_google_maps_api_key_here
